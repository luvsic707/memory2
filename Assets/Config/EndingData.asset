  stableEnding:
    title: Stable Ending
    description: 'Dora''s memory core has maintained remarkable integrity.


      Perhaps
      in this cold digital world, there is still a trace of warmth worth preserving.'
    debugLabel: "\u7ED3\u6784\u7A33\u56FA"
  unstableEnding:
    title: Unstable Ending
    description: 'The memory data remains intact, but irreversible fractures have
      appeared in the core structure.


      Will she still recognize who you are?'
    debugLabel: "\u7ED3\u6784\u9707\u8361"
  collapseEnding:
    title: Collapse Ending
    description: 'Entropy levels critical. System collapse.


      Everything has
      dissolved into the void of data noise.'
    debugLabel: "\u7ED3\u6784\u5D29\u584C"
